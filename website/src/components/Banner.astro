---
import { rewriteRootHrefs } from '../lib/withBase';

const { banner } = Astro.locals.starlightRoute.entry.data;
const content = banner
	? rewriteRootHrefs(banner.content, import.meta.env.BASE_URL)
	: '';
---

{
	banner && (
		<div class="sl-banner" data-pagefind-ignore set:html={content} />
	)
}

<style>
	.sl-banner {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
		color: var(--sl-color-banner-text, var(--sl-color-text-invert));
		line-height: var(--sl-line-height-headings);
		text-align: center;
		text-wrap: balance;
		box-shadow: var(--sl-shadow-sm);
	}

	.sl-banner :global(a) {
		color: var(--sl-color-banner-text, var(--sl-color-text-invert));
	}
</style>
