---
/**
 * Illustrative terminal island for the splash hero.
 * Diff → simplify → predict → coverage from the README pricing example.
 * Not a live CLI session.
 */
---

<figure class="hero-demo" aria-label="Illustrative Skia reading loop">
	<div class="hero-demo__chrome">
		<span class="hero-demo__dots" aria-hidden="true">
			<span></span><span></span><span></span>
		</span>
		<span class="hero-demo__title">skia 0.0.0 · foundation · README example</span>
		<span class="hero-demo__badge">ILLUSTRATIVE</span>
	</div>

	<div class="hero-demo__stage">
		<div class="hero-demo__frames" data-hero-demo-frames>
			<pre class="hero-demo__frame hero-demo__frame--diff" data-frame="0"><code set:html={`<span class="hd-meta">diff — calculateFinalPrice</span>
<span class="hd-fg"> function calculateFinalPrice(total, member, promotion) {</span>
<span class="hd-del">-  return total;</span>
<span class="hd-add">+  if (member) total *= 0.9;</span>
<span class="hd-add">+  if (promotion > 0) total -= promotion;</span>
<span class="hd-add">+  return Math.max(0, Math.round(total));</span>
<span class="hd-fg"> }</span>`} /></pre>

			<pre class="hero-demo__frame hero-demo__frame--simplify" data-frame="1"><code set:html={`<span class="hd-meta">SIMPLIFIED VIEW — not executable</span>
<span class="hd-muted">src/pricing.ts:12-18</span>

<span class="hd-green">if (member)        total = total * 0.90</span>
<span class="hd-green">if (promotion > 0)  total = total - promotion</span>
<span class="hd-green">return round(max(total, 0))</span>`} /></pre>

			<pre class="hero-demo__frame hero-demo__frame--predict" data-frame="2"><code set:html={`<span class="hd-muted">total=100, member=true, promotion=10</span>
<span class="hd-fg">What should calculateFinalPrice(...) return?</span>

<span class="hd-green">> 80</span>
<span class="hd-muted">  (developer_supplied — not a test result)</span>`} /></pre>

			<pre class="hero-demo__frame hero-demo__frame--coverage" data-frame="3"><code set:html={`<span class="hd-meta">coverage (illustrative labels)</span>
<span class="hd-chip">supported</span>  branches shown
<span class="hd-chip hd-chip--warn">not_available</span>  runtime result 80
<span class="hd-muted">next → open original source</span>`} /></pre>
		</div>

		{/* Static stack for prefers-reduced-motion and no-JS */}
		<pre class="hero-demo__static"><code set:html={`<span class="hd-meta">SIMPLIFIED VIEW — not executable</span>
<span class="hd-green">if (member)        total = total * 0.90</span>
<span class="hd-green">if (promotion > 0)  total = total - promotion</span>
<span class="hd-green">return round(max(total, 0))</span>

<span class="hd-muted">total=100, member=true, promotion=10</span>
<span class="hd-fg">What should calculateFinalPrice(...) return?</span>
<span class="hd-green">> 80</span>  <span class="hd-chip">supported</span> <span class="hd-chip hd-chip--warn">not_available</span>`} /></pre>
	</div>

	<figcaption class="hero-demo__caption">
		Illustrative / not a live CLI session
	</figcaption>
</figure>

<style>
	.hero-demo {
		--demo-bg: #0a0c10;
		--demo-border: #2a2f36;
		--demo-fg: #e6edf3;
		--demo-muted: #8b949e;
		--demo-green: #3fb950;
		--demo-red: #f85149;
		--demo-accent: #e6b15a;
		margin: 0;
		width: 100%;
		max-width: 720px;
		border: 1px solid var(--demo-border);
		border-radius: 12px;
		overflow: hidden;
		background: var(--demo-bg);
		color: var(--demo-fg);
		box-shadow:
			0 0 0 1px rgb(198 146 58 / 12%),
			0 22px 56px rgb(0 0 0 / 36%),
			0 0 80px rgb(196 146 58 / 8%);
	}

	.hero-demo__chrome {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 0.55rem 0.85rem;
		border-bottom: 1px solid var(--demo-border);
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		color: var(--demo-muted);
		background: #0d1117;
	}

	.hero-demo__dots {
		display: inline-flex;
		gap: 0.28rem;
	}

	.hero-demo__dots span {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: #484f58;
	}

	.hero-demo__title {
		flex: 1 1 auto;
		min-width: 0;
	}

	.hero-demo__badge {
		border: 1px solid var(--demo-border);
		border-radius: 999px;
		padding: 0.12rem 0.55rem;
		color: var(--demo-accent);
		white-space: nowrap;
	}

	.hero-demo__stage {
		position: relative;
		min-height: 11.5rem;
	}

	.hero-demo__frames,
	.hero-demo__frame,
	.hero-demo__static {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		line-height: 1.5;
		white-space: pre;
	}

	.hero-demo__frames {
		position: relative;
		min-height: 11.5rem;
	}

	.hero-demo__frame {
		position: absolute;
		inset: 0;
		padding: 1rem 1.05rem 1.15rem;
		overflow-x: auto;
		opacity: 0;
		visibility: hidden;
		animation: hero-demo-cycle 16s infinite;
	}

	.hero-demo__frame--diff {
		animation-delay: 0s;
	}
	.hero-demo__frame--simplify {
		animation-delay: 4s;
	}
	.hero-demo__frame--predict {
		animation-delay: 8s;
	}
	.hero-demo__frame--coverage {
		animation-delay: 12s;
	}

	.hero-demo :global(.hd-meta) {
		color: var(--demo-accent);
	}
	.hero-demo :global(.hd-fg) {
		color: var(--demo-fg);
	}
	.hero-demo :global(.hd-muted) {
		color: var(--demo-muted);
	}
	.hero-demo :global(.hd-green) {
		color: var(--demo-green);
	}
	.hero-demo :global(.hd-del) {
		color: #ffa198;
		background: rgb(248 81 73 / 15%);
	}
	.hero-demo :global(.hd-add) {
		color: #7ee787;
		background: rgb(63 185 80 / 15%);
	}
	.hero-demo :global(.hd-chip) {
		display: inline-block;
		border: 1px solid #3fb950;
		border-radius: 999px;
		padding: 0 0.4rem;
		color: #7ee787;
		font-size: 0.72rem;
	}
	.hero-demo :global(.hd-chip--warn) {
		border-color: #d29922;
		color: #e3b341;
	}

	.hero-demo__static {
		display: none;
		padding: 1rem 1.05rem 1.15rem;
		overflow-x: auto;
		color: var(--demo-fg);
	}

	.hero-demo__caption {
		padding: 0.5rem 0.9rem 0.65rem;
		border-top: 1px solid var(--demo-border);
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		color: var(--demo-muted);
		text-align: center;
		background: #0d1117;
	}

	@keyframes hero-demo-cycle {
		0%,
		24.9% {
			opacity: 1;
			visibility: visible;
		}
		25%,
		100% {
			opacity: 0;
			visibility: hidden;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-demo__frames {
			display: none;
		}

		.hero-demo__static {
			display: block;
		}

		.hero-demo__stage {
			min-height: 0;
		}
	}

	@media (max-width: 49.99rem) {
		.hero-demo {
			max-width: none;
			border-radius: 0;
			border-inline: 0;
		}

		.hero-demo__frame,
		.hero-demo__static {
			font-size: 0.74rem;
		}
	}
</style>
