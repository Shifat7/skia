---
/**
 * Illustrative reading-check island for the splash hero.
 * Simplified view, one prediction prompt, and coverage labels from the
 * README pricing example. Not a live CLI session. Not executable.
 */
---

<figure class="hero-demo" aria-label="Illustrative Skia reading check">
	<div class="hero-demo__chrome">
		<span class="hero-demo__mark" aria-hidden="true"></span>
		<span class="hero-demo__title">skia 0.0.0 · reading check</span>
		<span class="hero-demo__badge">ILLUSTRATIVE</span>
	</div>

	<div class="hero-demo__body">
		<p class="hero-demo__diff">
			<span class="hd-k">diff</span>
			<span class="hd-file">calculateFinalPrice</span>
			<span class="hd-add">+3</span>
			<span class="hd-del">−1</span>
		</p>

		<section class="hero-demo__block" aria-label="Simplified view">
			<p class="hero-demo__kicker">SIMPLIFIED VIEW — not executable</p>
			<p class="hero-demo__path">src/pricing.ts:12-18</p>
			<pre class="hero-demo__code"><code>if (member)        total = total * 0.90
if (promotion &gt; 0) total = total - promotion
return round(max(total, 0))</code></pre>
		</section>

		<section class="hero-demo__block" aria-label="Prediction prompt">
			<p class="hero-demo__kicker">PREDICT</p>
			<p class="hero-demo__scenario">total=100, member=true, promotion=10</p>
			<p class="hero-demo__prompt">What should calculateFinalPrice(...) return?</p>
			<p class="hero-demo__answer">
				<span class="hd-prompt" aria-hidden="true">&gt;</span>
				<span>80</span>
				<span class="hd-note">developer_supplied</span>
			</p>
		</section>

		<ul class="hero-demo__chips" aria-label="Coverage and uncertainty">
			<li><span class="hd-chip">supported</span> branches shown</li>
			<li><span class="hd-chip hd-chip--warn">not_available</span> runtime result</li>
		</ul>
	</div>

	<figcaption class="hero-demo__caption">Illustrative / not a live CLI session</figcaption>
</figure>

<style>
	.hero-demo {
		--demo-bg: #07080a;
		--demo-elev: #0c0d10;
		--demo-border: rgb(255 255 255 / 10%);
		--demo-fg: #f4f1ea;
		--demo-muted: #8d897f;
		--demo-accent: #e0a84a;
		margin: 0;
		width: 100%;
		border: 1px solid var(--demo-border);
		border-radius: 8px;
		overflow: hidden;
		background: var(--demo-bg);
		color: var(--demo-fg);
		box-shadow: 0 18px 50px rgb(0 0 0 / 45%);
	}

	.hero-demo__chrome {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 0.8rem;
		border-bottom: 1px solid var(--demo-border);
		background: var(--demo-elev);
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		color: var(--demo-muted);
	}

	.hero-demo__mark {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 2px;
		background: var(--demo-accent);
		flex: none;
	}

	.hero-demo__title {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-demo__badge {
		border: 1px solid rgb(224 168 74 / 55%);
		border-radius: 999px;
		padding: 0.08rem 0.5rem;
		color: var(--demo-accent);
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.hero-demo__body {
		display: flex;
		flex-direction: column;
	}

	.hero-demo__diff,
	.hero-demo__kicker,
	.hero-demo__path,
	.hero-demo__scenario,
	.hero-demo__prompt,
	.hero-demo__answer {
		margin: 0;
	}

	.hero-demo__diff {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem;
		padding: 0.45rem 0.9rem;
		border-bottom: 1px solid var(--demo-border);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: var(--demo-muted);
	}

	.hero-demo__block {
		padding: 0.55rem 0.85rem 0.6rem;
		border-bottom: 1px solid var(--demo-border);
	}

	.hero-demo__kicker {
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.03em;
		color: var(--demo-accent);
	}

	.hero-demo__path,
	.hero-demo__scenario,
	.hd-note {
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		color: var(--demo-muted);
	}

	.hero-demo__path,
	.hero-demo__scenario {
		margin-top: 0.2rem;
	}

	.hero-demo__code {
		margin: 0.35rem 0 0;
		overflow-x: auto;
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--demo-fg);
	}

	.hero-demo__prompt {
		margin-top: 0.3rem;
		font-size: 0.9rem;
		line-height: 1.35;
		color: var(--demo-fg);
	}

	.hero-demo__answer {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.45rem;
		margin-top: 0.3rem;
		font-family: var(--sl-font-mono);
		font-size: 0.92rem;
	}

	.hd-prompt {
		color: var(--demo-accent);
	}

	.hd-k {
		color: var(--demo-muted);
	}

	.hd-file {
		color: var(--demo-fg);
	}

	.hd-add {
		color: #7dcea0;
	}

	.hd-del {
		color: #e7a09a;
	}

	.hero-demo__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.9rem;
		margin: 0;
		padding: 0.4rem 0.85rem 0.5rem;
		list-style: none;
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		color: var(--demo-muted);
	}

	.hero-demo__chips li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.hd-chip {
		border: 1px solid rgb(255 255 255 / 16%);
		border-radius: 999px;
		padding: 0.02rem 0.42rem;
		color: var(--demo-fg);
	}

	.hd-chip--warn {
		border-color: rgb(224 168 74 / 55%);
		color: var(--demo-accent);
	}

	.hero-demo__caption {
		padding: 0.45rem 0.9rem 0.55rem;
		border-top: 1px solid var(--demo-border);
		background: var(--demo-elev);
		font-family: var(--sl-font-mono);
		font-size: 0.7rem;
		color: var(--demo-muted);
		text-align: start;
	}

	@media (max-width: 49.99rem) {
		.hero-demo {
			border-radius: 0;
			border-inline: 0;
			box-shadow: none;
		}

		.hero-demo__block {
			padding-block: 0.45rem;
		}

		.hero-demo__code {
			font-size: 0.74rem;
		}

		.hero-demo__chips {
			gap: 0.3rem 0.65rem;
			padding-block: 0.35rem;
		}

		.hero-demo__caption {
			padding-block: 0.35rem;
		}
	}
</style>
