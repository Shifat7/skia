---
import { LinkButton } from '@astrojs/starlight/components';
import HeroDemo from './HeroDemo.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="splash-hero">
	<div class="splash-hero__copy">
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <div class="splash-hero__tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="splash-hero__actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
	</div>

	<div class="splash-hero__demo">
		<HeroDemo />
	</div>
</div>

<style>
	.splash-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		padding-block: 0.55rem 0.4rem;
		text-align: center;
	}

	.splash-hero__copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		max-width: 40rem;
		padding-inline: 0.25rem;
	}

	.splash-hero h1 {
		margin: 0;
		font-size: clamp(1.75rem, 0.5rem + 3.1vw, 2.5rem);
		line-height: 1.15;
		font-weight: 650;
		color: var(--sl-color-white);
		max-width: 16ch;
	}

	.splash-hero__tagline {
		margin: 0;
		font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.05rem);
		line-height: 1.45;
		color: var(--sl-color-gray-2);
		max-width: 48ch;
	}

	.splash-hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem 0.85rem;
	}

	.splash-hero__demo {
		width: 100%;
		display: flex;
		justify-content: center;
	}

	@media (max-width: 49.99rem) {
		.splash-hero {
			align-items: stretch;
			text-align: start;
			gap: 0.95rem;
			padding-block: 0.25rem 0.2rem;
		}

		.splash-hero__copy {
			align-items: stretch;
			max-width: none;
			padding-inline: 0;
		}

		.splash-hero h1 {
			max-width: none;
		}

		.splash-hero__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.splash-hero__actions :global(.sl-link-button) {
			justify-content: center;
			width: 100%;
		}

		.splash-hero__demo {
			width: 100vw;
			margin-inline: calc(50% - 50vw);
		}
	}

	@media (min-width: 50rem) {
		.splash-hero {
			padding-block: 0.7rem 0.5rem;
			gap: 1.2rem;
		}
	}
</style>
