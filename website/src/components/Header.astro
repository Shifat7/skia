---
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import { withBase } from '../lib/withBase';

const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const statusHref = withBase('/status/');
const githubHref = 'https://github.com/Shifat7/skia';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	{
		!isSplash && (
			<div class="search-slot">
				<Search {...Astro.props} />
			</div>
		)
	}
	<div class:list={['right-group', 'sl-flex', { 'right-group--docs': !isSplash }]}>
		<a class="nav-status" href={statusHref}>Status</a>
		<a class="nav-status" href={githubHref}>GitHub</a>
	</div>
</div>

<style>
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
	}

	.title-wrapper {
		min-width: 0;
		overflow: clip;
	}

	.search-slot {
		flex: 1 1 auto;
		display: flex;
		justify-content: flex-end;
		min-width: 0;
	}

	.right-group {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex: none;
	}

	/* Docs pages keep Starlight's menu toggle in this corner below 50rem. */
	@media (max-width: 49.99rem) {
		.right-group--docs {
			display: none;
		}
	}

	.nav-status {
		color: var(--sl-color-gray-1);
		font-size: 0.72rem;
		font-weight: 560;
		letter-spacing: 0.14em;
		text-decoration: none;
		text-transform: uppercase;
		padding: 0.35rem 0.45rem;
	}

	.nav-status:hover {
		color: var(--sl-color-white);
	}
</style>
